meta {
  name: sandbox create access-token
  type: http
  seq: 4
}

post {
  url: {{base-url}}/disbursement/token/
  body: json
  auth: basic
}

headers {
  X-Reference-Id: {{reference-id}}
  Ocp-Apim-Subscription-Key: {{subscription-key}}
}

auth:basic {
  username: {{reference-id}}
  password: {{api-key}}
}

body:json {
  {
      "providerCallbackHost": "{{callback-host}}"
  }
}

