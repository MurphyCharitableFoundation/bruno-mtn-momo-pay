meta {
  name: sandbox get user info.
  type: http
  seq: 3
}

get {
  url: {{base-url}}/v1_0/apiuser/{{reference-id}}
  body: json
  auth: none
}

headers {
  X-Reference-Id: {{reference-id}}
  Ocp-Apim-Subscription-Key: {{subscription-key}}
}

body:json {
  {
      "providerCallbackHost": "{{callback-host}}"
  }
}

docs {
  Example Response
  
  {
    "providerCallbackHost": "localhost",
    "targetEnvironment": "sandbox"
  }
}
